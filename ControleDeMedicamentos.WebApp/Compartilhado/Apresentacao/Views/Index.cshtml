@{
    ViewBag.Titulo = "Painel de Controle";
}

<div class="p-4 p-lg-5 mb-4 rounded-4 text-white" style="background: linear-gradient(120deg, #065f52, #0b9b84);">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="badge rounded-pill bg-white text-success mb-3">
                <i class="bi bi-heart-pulse-fill me-1"></i> Gestão integrada
            </span>

            <h2 class="display-6 fw-bold">Controle seus medicamentos com segurança.</h2>

            <p class="lead mb-4 opacity-75">
                Gerencie medicamentos, pacientes, fornecedores e movimentações
                de estoque em um único lugar.
            </p>

            <a class="btn btn-light text-success fw-semibold px-4" asp-controller="Medicamento" asp-action="Listar">
                <i class="bi bi-capsule me-2"></i>Ver medicamentos
            </a>

            <a class="btn btn-outline-light fw-semibold px-4 ms-sm-2 mt-2 mt-sm-0" asp-controller="RequisicaoEntrada"
               asp-action="Cadastrar">
                <i class="bi bi-plus-circle me-2"></i>Registrar entrada
            </a>
        </div>

        <div class="col-lg-4 text-center d-none d-lg-block">
            <i class="bi bi-clipboard2-pulse" style="font-size: 9rem; opacity: .25;"></i>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h3 class="h5 fw-bold mb-1">Módulos do sistema</h3>
        <p class="text-secondary mb-0">Acesse rapidamente as principais operações.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <a class="card h-100 border-0 bg-success-subtle text-decoration-none shadow-sm" asp-controller="Medicamento"
           asp-action="Listar">
            <div class="card-body p-4">
                <i class="bi bi-capsule fs-2 text-success"></i>
                <h4 class="h6 fw-bold text-dark mt-3">Medicamentos</h4>
                <p class="small text-secondary mb-0">Cadastros, fornecedores e disponibilidade.</p>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-xl-3">
        <a class="card h-100 border-0 bg-primary-subtle text-decoration-none shadow-sm" asp-controller="Paciente"
           asp-action="Listar">
            <div class="card-body p-4">
                <i class="bi bi-people fs-2 text-primary"></i>
                <h4 class="h6 fw-bold text-dark mt-3">Pacientes</h4>
                <p class="small text-secondary mb-0">Informações dos pacientes atendidos.</p>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-xl-3">
        <a class="card h-100 border-0 bg-info-subtle text-decoration-none shadow-sm" asp-controller="Fornecedor"
           asp-action="Listar">
            <div class="card-body p-4">
                <i class="bi bi-truck fs-2 text-info"></i>
                <h4 class="h6 fw-bold text-dark mt-3">Fornecedores</h4>
                <p class="small text-secondary mb-0">Empresas responsáveis pelo abastecimento.</p>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-xl-3">
        <a class="card h-100 border-0 bg-warning-subtle text-decoration-none shadow-sm" asp-controller="Funcionario"
           asp-action="Listar">
            <div class="card-body p-4">
                <i class="bi bi-person-badge fs-2 text-warning"></i>
                <h4 class="h6 fw-bold text-dark mt-3">Funcionários</h4>
                <p class="small text-secondary mb-0">Equipe responsável pelas operações.</p>
            </div>
        </a>
    </div>

    <div class="col-md-6">
        <a class="card h-100 border-success-subtle text-decoration-none shadow-sm" asp-controller="RequisicaoEntrada"
           asp-action="Listar">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <i class="bi bi-box-arrow-in-down fs-1 text-success"></i>
                <div>
                    <h4 class="h6 fw-bold text-dark mb-1">Entradas no estoque</h4>
                    <p class="small text-secondary mb-0">Registre e consulte o recebimento de medicamentos.</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6">
        <a class="card h-100 border-danger-subtle text-decoration-none shadow-sm" asp-controller="RequisicaoSaida"
           asp-action="Listar">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <i class="bi bi-box-arrow-up fs-1 text-danger"></i>
                <div>
                    <h4 class="h6 fw-bold text-dark mb-1">Saídas do estoque</h4>
                    <p class="small text-secondary mb-0">Controle a entrega de medicamentos aos pacientes.</p>
                </div>
            </div>
        </a>
    </div>
</div>