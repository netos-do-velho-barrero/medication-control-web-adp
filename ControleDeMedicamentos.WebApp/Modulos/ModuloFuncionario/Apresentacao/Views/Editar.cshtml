@using ControleDeMedicamentos.WebApp.ModuloFuncionario.Dominio
@using ControleDeMedicamentos.WebApp.ModuloFuncionario.Apresentacao

@model EditarFuncionarioViewModel

@{
    ViewBag.Titulo = "Editar Funcionário";
}

<div class="content-panel p-4">

    <h2 class="h4 mb-1">Editar funcionário</h2>

    <p class="text-secondary mb-4">
        Atualize os dados do funcionário.
    </p>

    <form asp-action="Editar" method="post">

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome do funcionário</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Telefone" class="form-label">Telefone do funcionário</label>
            <input asp-for="Telefone" class="form-control" />
            <span asp-validation-for="Telefone" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Cpf" class="form-label">CPF</label>
            <input asp-for="Cpf" class="form-control" />
            <span asp-validation-for="Cpf" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Salvar alterações</button>
            <a class="btn btn-outline-secondary" asp-action="Listar">Voltar</a>
        </div>

    </form>

</div>