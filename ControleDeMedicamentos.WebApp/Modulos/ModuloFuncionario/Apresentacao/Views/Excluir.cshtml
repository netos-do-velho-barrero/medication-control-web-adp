
@using ControleDeMedicamentos.WebApp.ModuloFuncionario.Apresentacao

@model ExcluirFuncionarioViewModel

@{
    ViewBag.Titulo = "Excluir Funcionário";
}

<div class="content-panel p-4">

    <div class="alert alert-warning">
        Tem certeza que deseja excluir este funcionário?
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">Nome</span>
                <div class="fw-semibold">@Model.Nome</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">Telefone</span>
                <div class="fw-semibold">@Model.Telefone</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">CPF</span>
                <div class="fw-semibold">@Model.Cpf</div>
            </div>
        </div>

    </div>

    <form asp-action="Excluir" method="post">

        <input asp-for="Id" type="hidden" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                Confirmar exclusão
            </button>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                Cancelar
            </a>
        </div>

    </form>

</div>