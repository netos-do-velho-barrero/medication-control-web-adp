@using ControleDeMedicamentos.WebApp.ModuloPaciente.Dominio
@using ControleDeMedicamentos.WebApp.ModuloPaciente.Apresentacao

@model CadastrarPacienteViewModel

@{
    ViewBag.Titulo = "Cadastrar Paciente";
}

<div class="content-panel p-4">
    <h2 class="h4 mb-1">Novo paciente</h2>
    <p class="text-secondary mb-4">
        Informe os dados do paciente para realizar o cadastro.
    </p>
    <form asp-action="Cadastrar" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome do paciente</label>
            <input asp-for="Nome" class="form-control" placeholder="Ex: João da Silva" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Telefone" class="form-label">Telefone do paciente</label>
            <input asp-for="Telefone" class="form-control" placeholder="Ex: (49) 99999-9999" />
            <span asp-validation-for="Telefone" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CartaoSus" class="form-label">Cartão do SUS</label>
            <input asp-for="CartaoSus" class="form-control" placeholder="Ex: 123456789012345" />
            <span asp-validation-for="CartaoSus" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Cpf" class="form-label">CPF</label>
            <input asp-for="Cpf" class="form-control" placeholder="Ex: 123.456.789-00" />
            <span asp-validation-for="Cpf" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Cadastrar</button>
        </div>
    </form>
</div>