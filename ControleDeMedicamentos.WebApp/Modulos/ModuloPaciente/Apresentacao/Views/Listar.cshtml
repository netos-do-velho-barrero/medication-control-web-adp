@model List<ControleDeMedicamentos.WebApp.ModuloPaciente.Apresentacao.ListarPacienteViewModel>

@{
    ViewBag.Titulo = "Pacientes";
}

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" asp-controller="Paciente" asp-action="Cadastrar">Cadastrar Paciente</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhum paciente cadastrado.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Telefone</th>
                <th>Cartão SUS</th>
                <th>CPF</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var paciente in Model)
            {
                <tr>
                    <td>@paciente.Nome</td>
                    <td>@paciente.Telefone</td>
                    <td>@paciente.CartaoSus</td>
                    <td>@paciente.Cpf</td>
                    <td class="text-end">
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Paciente" asp-action="Editar"
                           asp-route-id="@paciente.Id">
                            Editar
                        </a>

                        <a class="btn btn-outline-danger btn-sm" asp-controller="Paciente" asp-action="Excluir"
                           asp-route-id="@paciente.Id">
                            Excluir
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}