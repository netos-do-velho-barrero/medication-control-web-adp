@model ControleDeMedicamentos.WebApp.ModuloMedicamento.Apresentacao.ExcluirMedicamentoViewModel

@{
    ViewBag.Titulo = "Excluir Medicamento";
}

<div class="alert alert-warning">
    Tem certeza que deseja excluir o medicamento <strong>@Model.Nome</strong>?
</div>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">Fornecedor</dt>
    <dd class="col-sm-10">@Model.FornecedorNome</dd>
</dl>

<form asp-controller="Medicamento" asp-action="ExcluirConfirmado" asp-route-id="@Model.Id" method="post">
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a class="btn btn-outline-secondary" asp-controller="Medicamento" asp-action="Listar">Cancelar</a>
    </div>
</form>