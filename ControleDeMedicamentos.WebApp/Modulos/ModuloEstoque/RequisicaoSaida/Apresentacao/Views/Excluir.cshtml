@model ControleDeMedicamentos.WebApp.ModuloEstoque.RequisicoesSaida.Apresentacao.ListarRequisicaoSaidaViewModel

@{
    ViewBag.Titulo = "Excluir Requisição de Saída";
}

<div class="content-panel p-4">

    <div class="alert alert-warning">
        Tem certeza que deseja excluir esta requisição de saída? O estoque do medicamento será devolvido automaticamente.
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">Data da Requisição</span>
                <div class="fw-semibold">@Model.Data.ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">Medicamento</span>
                <div class="fw-semibold">@Model.MedicamentoNome</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">Paciente</span>
                <div class="fw-semibold">@Model.PacienteNome</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">Quantidade Retirada</span>
                <div class="fw-semibold">@Model.Quantidade</div>
            </div>
        </div>

    </div>

    <form asp-controller="RequisicaoSaida" asp-action="Excluir" method="post">

        <input asp-for="Id" type="hidden" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                Confirmar exclusão
            </button>
            <a class="btn btn-outline-secondary" asp-controller="RequisicaoSaida" asp-action="Listar">
                Cancelar
            </a>
        </div>

    </form>

</div>