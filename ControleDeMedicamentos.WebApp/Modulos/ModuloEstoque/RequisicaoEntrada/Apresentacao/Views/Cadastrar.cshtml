@model ControleDeMedicamentos.WebApp.ModuloEstoque.RequisicoesEntrada.Apresentacao.CadastrarRequisicaoEntradaViewModel

@{
    ViewBag.Titulo = "Cadastrar Requisição de Entrada";
}

<form asp-controller="RequisicaoEntrada" asp-action="Cadastrar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Data" class="form-label"></label>
        <input asp-for="Data" class="form-control" type="date" />
        <span asp-validation-for="Data" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MedicamentoId" class="form-label">Medicamento</label>
        <select asp-for="MedicamentoId" asp-items="Model.Medicamentos" class="form-select">
            <option value="">Selecione um medicamento</option>
        </select>
        <span asp-validation-for="MedicamentoId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FuncionarioId" class="form-label">Funcionário</label>
        <select asp-for="FuncionarioId" asp-items="Model.Funcionarios" class="form-select">
            <option value="">Selecione um funcionário</option>
        </select>
        <span asp-validation-for="FuncionarioId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantidade" class="form-label"></label>
        <input asp-for="Quantidade" class="form-control" type="number" min="1" />
        <span asp-validation-for="Quantidade" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Cadastrar</button>
        <a class="btn btn-outline-secondary" asp-controller="RequisicaoEntrada" asp-action="Listar">Voltar</a>
    </div>
</form>