@model List<ControleDeMedicamentos.WebApp.ModuloEstoque.RequisicoesEntrada.Apresentacao.ListarRequisicaoEntradaViewModel>

@{
    ViewBag.Titulo = "Requisições de Entrada";
}

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" asp-controller="RequisicaoEntrada" asp-action="Cadastrar">
        Nova Requisição de Entrada
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhuma requisição de entrada cadastrada.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Data</th>
                <th>Medicamento</th>
                <th>Funcionário</th>
                <th>Quantidade</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var requisicao in Model)
            {
                <tr>
                    <td>@requisicao.Data.ToString("dd/MM/yyyy")</td>
                    <td>@requisicao.MedicamentoNome</td>
                    <td>@requisicao.FuncionarioNome</td>
                    <td>@requisicao.Quantidade</td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="RequisicaoEntrada" asp-action="Editar" asp-route-id="@requisicao.Id">
                                Editar
                            </a>
                            <a class="btn btn-sm btn-outline-danger" asp-controller="RequisicaoEntrada" asp-action="Excluir" asp-route-id="@requisicao.Id">
                                Excluir
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}