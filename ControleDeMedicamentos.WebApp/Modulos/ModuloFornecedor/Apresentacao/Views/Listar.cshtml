@model List<ControleDeMedicamentos.WebApp.ModuloFornecedor.Apresentacao.ListarFornecedorViewModel>

@{
    ViewBag.Titulo = "Fornecedores";
}

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" asp-controller="Fornecedor" asp-action="Cadastrar">Cadastrar Fornecedor</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhum fornecedor cadastrado.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Telefone</th>
                <th>CNPJ</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fornecedor in Model)
            {
                <tr>
                    <td>@fornecedor.Nome</td>
                    <td>@fornecedor.Telefone</td>
                    <td>@fornecedor.Cnpj</td>
                    <td class="text-end">
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Fornecedor" asp-action="Editar"
                           asp-route-id="@fornecedor.Id">
                            Editar
                        </a>

                        <a class="btn btn-outline-danger btn-sm" asp-controller="Fornecedor" asp-action="Excluir"
                           asp-route-id="@fornecedor.Id">
                            Excluir
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}