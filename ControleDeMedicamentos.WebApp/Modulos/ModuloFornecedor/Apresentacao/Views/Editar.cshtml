@model ControleDeMedicamentos.WebApp.ModuloFornecedor.Apresentacao.EditarFornecedorViewModel

@{
    ViewBag.Titulo = "Editar Fornecedor";
}

<form asp-controller="Fornecedor" asp-action="Editar" method="post">
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefone" class="form-label"></label>
        <input asp-for="Telefone" class="form-control" />
        <span asp-validation-for="Telefone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Cnpj" class="form-label"></label>
        <input asp-for="Cnpj" class="form-control" />
        <span asp-validation-for="Cnpj" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a class="btn btn-outline-secondary" asp-controller="Fornecedor" asp-action="Listar">Voltar</a>
    </div>
</form>